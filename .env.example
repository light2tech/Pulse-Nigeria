# OPENROUTER_API_KEY: OpenRouter API key (starts with sk-or-v1-...) for AI Study Tutor.
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# GEMINI_API_KEY: Optional fallback Gemini AI API key.
GEMINI_API_KEY="your_gemini_api_key"

# COPILOT_API_KEY: Optional OpenAI-compatible gateway API key.
COPILOT_API_KEY="your_copilot_api_key"
COPILOT_BASE_URL="https://openrouter.ai/api/v1"
COPILOT_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# SUPABASE_URL: Supabase Project URL (or Project Reference ID)
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Client-side Supabase Publishable / Anon Key
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_or_anon_key"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_or_anon_key"

# SUPABASE_SECRET_KEY: Server-side Supabase Secret / Service Role Key (keep private)
SUPABASE_SECRET_KEY="your_supabase_secret_or_service_role_key"

# SUPABASE_JWKS_URL: Optional JWKS endpoint for token verification
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
